# Oathbound server configuration — copy to /etc/oathbound/server.env and edit.
# Every value has a sensible default (see server/config.ts); uncomment only what
# you want to change. This file is read by the systemd unit (EnvironmentFile).
#
#   sudo mkdir -p /etc/oathbound
#   sudo cp deploy/server.env.example /etc/oathbound/server.env
#   sudo chown root:oathbound /etc/oathbound/server.env && sudo chmod 640 /etc/oathbound/server.env
#
# NOTE: systemd EnvironmentFile parses KEY=value literally — do NOT quote values
# or add inline comments after them, and no spaces around '='.

# --- Network ---
# Port the Node server listens on (Caddy proxies wss://host/ws → here).
OATHBOUND_PORT=8080
# WebSocket path (must match the reverse_proxy matcher in the Caddyfile).
OATHBOUND_WS_PATH=/ws

# --- World ---
# Map name (a <name>.oathbound-map.json in public/maps, or OATHBOUND_MAP_DIR).
OATHBOUND_MAP=talar
# Gameplay RNG seed — the authority for loot/crit/AI rolls. Keep stable across restarts.
#OATHBOUND_SEED=12648430

# --- Persistence ---
# SQLite database file. MUST live under the unit's ReadWritePaths (/var/lib/oathbound).
OATHBOUND_DB=/var/lib/oathbound/oathbound.db
# How often (seconds) to flush in-world characters to SQLite.
OATHBOUND_SAVE_INTERVAL_S=30

# --- Access control ---
# Friends-only lock: a shared password required at register (empty = open registration).
#OATHBOUND_JOIN_PASSWORD=changeme
# Comma-separated usernames auto-promoted to admin on login (for /admin commands).
#OATHBOUND_ADMINS=yourname,friendname
# Max simultaneous connections from one IP (raise only for a local load test).
#OATHBOUND_MAX_CONN_PER_IP=8

# --- Presentation ---
#OATHBOUND_MOTD=Welcome to our Oathbound server — be excellent to each other.
# Snapshot broadcast rate (Hz). 15 is plenty for friends-scale; lower to save bandwidth.
#OATHBOUND_SNAPSHOT_HZ=15
